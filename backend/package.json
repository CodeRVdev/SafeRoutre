{
  "name": "saferoute-backend",
  "version": "1.0.0",
  "description": "SafeRoute Backend - Emergency Evacuation Guidance System API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node-dev --transpile-only src/db/migrate.ts",
    "seed": "ts-node-dev --transpile-only src/db/seed.ts",
    "db:migrate": "ts-node-dev --transpile-only src/db/migrate.ts",
    "db:seed": "ts-node-dev --transpile-only src/db/seed.ts",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "keywords": [
    "saferoute",
    "evacuation",
    "express",
    "typescript",
    "postgis",
    "jwt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.2.0",
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
