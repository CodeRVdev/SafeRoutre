# =================================================================
# SafeRoute Backend — Production Environment Configuration Template
# Target: Hostinger KVM 2 (Ubuntu 22.04/24.04 LTS)
# =================================================================
# Instructions:
# 1. Copy this file to backend/.env on your server: cp .env.production.example .env
# 2. Replace all placeholder values marked with "CHANGE_THIS"
# 3. Ensure this file is NEVER committed to Git or publicly exposed.
# =================================================================

# Server Execution Mode
NODE_ENV=production

# Network Binding
# Bind strictly to localhost (127.0.0.1) so Node.js is only accessible via Nginx reverse proxy
HOST=127.0.0.1
PORT=5000

# PostgreSQL + PostGIS Database Configuration
# Recommended: Create a dedicated application user 'saferoute_app' instead of using postgres superuser
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=saferoute_db
DB_USER=saferoute_app
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Optional full connection string (if preferred over individual DB_* variables):
# DATABASE_URL=postgresql://saferoute_app:CHANGE_THIS_TO_A_STRONG_PASSWORD@127.0.0.1:5432/saferoute_db

# JWT Authentication
# Generate a cryptographically secure 64-character secret (e.g., using: openssl rand -base64 48)
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_64_CHARS
JWT_EXPIRES_IN=24h

# CORS (Cross-Origin Resource Sharing)
# Restrict to your verified production domain(s). Comma-separated if multiple.
# Do NOT use '*' in production.
CORS_ORIGIN=https://YOUR_DOMAIN

# Upload Storage Directory
UPLOAD_DIR=uploads/hazards

# Firebase Cloud Messaging (FCM) Service Account Path
# Place your real serviceAccountKey.json inside backend/config/ and set the path below:
FIREBASE_SERVICE_ACCOUNT_PATH=config/serviceAccountKey.json
