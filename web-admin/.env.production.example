# =================================================================
# SafeRoute Web Admin — Production Environment Configuration Template
# Target: Hostinger KVM 2 (Nginx reverse proxy + React SPA)
# =================================================================
# Instructions:
# 1. Copy this file to web-admin/.env on your server: cp .env.production.example .env
# 2. When deployed behind Nginx, relative path "/api" is recommended because Nginx proxies
#    "/api/" to the backend at http://127.0.0.1:5000/api/ without cross-origin preflight.
# 3. For Socket.IO, point to your production HTTPS domain (e.g., https://YOUR_DOMAIN).
# =================================================================

# API Base URL (Relative path '/api' or absolute 'https://YOUR_DOMAIN/api')
VITE_API_URL=/api

# Real-Time WebSocket / Socket.IO Server URL
VITE_SOCKET_URL=https://YOUR_DOMAIN
